# Copy this file to ".env" and fill in real values before running locally.
# On a hosting platform (Render / Railway / etc.) set these as Environment Variables instead.

# Your Anthropic API key (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Any long random string - used to sign login sessions. Change this to something unique.
JWT_SECRET=change-this-to-a-long-random-string

# Port the server listens on (most hosts set this automatically - only needed for local runs)
PORT=3000
